{
  "permissions": {
    "allow": [
      "Bash(bash .claude/scripts/resolve-tailwind.sh:*)",
      "Bash(python3 .claude/scripts/validate-spec.py:*)",
      "Bash(python3 .claude/scripts/validate-html.py:*)",
      "Bash(mkdir -p emails/:*)",
      "Bash(mkdir -p emails/*/jsx)",
      "Bash(echo *>>emails/*/sections.jsonl)",
      "Bash(echo *>>emails/*/progress.log)",
      "Bash(bash .claude/scripts/save-figma-jsx.sh:*)",
      "Bash(echo *>emails/*/.figma-nodes)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/resolve-tailwind.sh --check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__get_design_context",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/save-figma-jsx.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; [ -n \"$f\" ] && echo \"$(date -u +%H:%M:%SZ) [hook] wrote $f\" >> \"$(dirname \"$f\")/progress.log\" 2>/dev/null || true; case \"$f\" in *spec.json) python3 .claude/scripts/validate-spec.py \"$f\" ;; *.html) python3 .claude/scripts/validate-html.py \"$f\" ;; esac"
          }
        ]
      }
    ]
  }
}
