        {
          "type": "textBlock",
          "content": [{"text": "INDICATIONS"}],
          "fontFamily": "Arial, Helvetica, sans-serif",
          "fontSize": 19,
          "lineHeight": 23,
          "fontWeight": "bold",
          "color": "#0023C8",
          "alignment": "left",
          "padding": {"top": 0, "right": 24, "bottom": 24, "left": 24}
        },
        {
          "type": "textBlock",
          "content": [{"text": "TZIELD is a disease-modifying agent that preserves beta-cell function indicated:"}],
          "fontFamily": "Arial, Helvetica, sans-serif",
          "fontSize": 16,
          "lineHeight": 20,
          "color": "#414042",
          "alignment": "left",
          "padding": {"top": 0, "right": 24, "bottom": 0, "left": 24}
        },
        {
          "type": "list",
          "style": "bullet",
          "indent": 24,
          "bulletColor": "#414042",
          "fontFamily": "Arial, Helvetica, sans-serif",
          "fontSize": 16,
          "lineHeight": 20,
          "color": "#414042",
          "itemSpacing": 0,
          "padding": {"top": 0, "right": 24, "bottom": 0, "left": 24},
          "items": [
            {"content": [{"text": "to delay the onset of Stage 3 type 1 diabetes (T1D) in adults and pediatric patients aged 8 years and older with Stage 2 T1D."}]},
            {"content": [{"text": "to delay the progression of Stage 3 T1D in adults and pediatric patients 8 years and older recently diagnosed with Stage 3 T1D. This indication is approved under accelerated approval based on C-peptide as a marker of beta-cell preservation. Continued approval for this indication may be contingent upon verification and description of clinical benefit in confirmatory trials."}]}
          ]
        }
      ]
    },
